# ═══════════════════════════════════════════════════════
# CulinaryVLM — Environment Variables Template
# Copy to .env and fill in your values
# ═══════════════════════════════════════════════════════

# ── API Keys (required for pipeline stages) ──
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
HF_TOKEN=your_huggingface_token_here

# ── Agent Layer Toggle ──
USE_AGENT_LAYER=true

# ── Database ──
DATABASE_URL=sqlite:///datasets/culinary_vlm.db

# ── Model ──
HF_MODEL_REPO=your_username/culinary-vlm-11b

# ── API Server ──
API_HOST=0.0.0.0
API_PORT=8000
